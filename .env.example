# Copy to .env (git-ignored) and fill in. Never commit real keys.
SERPAPI_API_KEY=

# auto  = live SerpApi when a key is set, otherwise cached evidence only
# live  = always call SerpApi (falls back to cache on errors)
# cache = never call SerpApi; serve previously retrieved, cached responses only
BENCHCHECK_EVIDENCE_MODE=auto

# Server-enforced evidence budget per file/settings session. Live credit counts are estimates.
BENCHCHECK_MAX_QUERIES=3
BENCHCHECK_MAX_EXTRACTS=5

# Override when serving on an explicitly chosen hostname (comma-separated, no scheme).
BENCHCHECK_ALLOWED_HOSTS=127.0.0.1,localhost,[::1],testserver
